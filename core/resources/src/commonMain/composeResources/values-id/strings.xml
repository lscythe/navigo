    <string name="core_designsystem_brand_tag">Jelajahi. Terhubung. Berangkat.</string>
    <string name="core_ui_onboarding_feed_page_title">Dua sumber. Satu peta kondisi sebenarnya.</string>
    <string name="core_ui_onboarding_feed_page_description">Navigo menggabungkan data langsung operator dengan laporan penumpang untuk mencakup seluruh jaringan, termasuk mikrotrans, angkot, dan bus yang pelacaknya dimatikan.</string>
    <string name="core_ui_onboarding_gps_feed_title">Titik GPS tak bisa memberi tahu apakah kamu akan kebagian tempat.</string>
    <string name="core_ui_onboarding_gps_feed_description">Data operator menunjukkan posisi bus. Penumpang di dalam melaporkan kepadatan, tarif hari ini, dan pengalihan rute. Navigo selalu menunjukkan kapan laporan itu dibuat.</string>
    <string name="core_ui_onboarding_alarm_page_title">Tidurlah. Kami bangunkan saat hampir tiba.</string>
    <string name="core_ui_onboarding_alarm_page_description">Atur alarm turun dan Navigo akan berbunyi satu halte sebelumnya, meski layar terkunci dan ponsel ada di saku. Navigo membaca kedua sumber, jadi alarm tetap berfungsi di rute yang tak pernah dilacak operator.</string>
    <string name="core_ui_onboarding_feed_page_first_item">Data operator jika tersedia</string>
    <string name="core_ui_onboarding_feed_page_second_item">Laporan penumpang jika tidak tersedia</string>
    <string name="core_ui_onboarding_feed_page_third_item">Setiap titik menunjukkan asal datanya</string>
    <string name="core_ui_onboarding_alarm_page_first_item">Tetap berbunyi saat sinyal hilang semenit</string>
    <string name="core_ui_onboarding_alarm_page_second_item">Berfungsi luring pada peta yang sudah diunduh</string>
    <string name="core_ui_onboarding_gps_disclosure_note">Saat suatu rute kehilangan data, Navigo akan mengatakannya, bukan mengarang angka. Perjalananmu membantu mengisi kekosongan untuk penumpang berikutnya.</string>
